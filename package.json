{
  "name": "axen-kit-playground",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "Public Axen Kit and real Axen Form scenario shell, with source/config and results",
  "scripts": {
    "dev": "vite --host 0.0.0.0",
    "check": "tsc --noEmit",
    "build": "tsc --noEmit && vite build",
    "preview": "vite preview --host 0.0.0.0",
    "test:browser": "playwright test --config=tests/playwright.config.ts"
  },
  "dependencies": {
    "@axenstudio/axen-form": "0.1.19",
    "react": "19.3.1",
    "react-dom": "19.3.1",
    "react-router-dom": "7.13.1",
    "yup": "1.7.1",
    "zod": "3.25.76"
  },
  "devDependencies": {
    "@playwright/test": "1.56.1",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "@vitejs/plugin-react": "4.7.0",
    "typescript": "5.9.3",
    "vite": "6.4.1"
  }
}
